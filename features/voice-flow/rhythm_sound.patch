NEW:
function tabla(t,dur,isLong,vol,pitchMul){
  pitchMul=pitchMul||1;
  const c=A.ctx, f=(isLong?311:370)*pitchMul, decay=isLong?Math.min(0.7,dur*1.1):Math.min(0.2,dur*0.9);
  [1,2,3,4.15].forEach((h,i)=>{const o=c.createOscillator(); o.type='sine'; o.frequency.value=f*h;
    const g=c.createGain(); const d=decay/(1+i*0.7); g.gain.setValueAtTime(0,t); g.gain.linearRampToValueAtTime(0.55*vol/(i+1),t+0.004);
    g.gain.exponentialRampToValueAtTime(0.0006,t+d); o.connect(g); g.connect(A.dest||A.out); o.start(t); o.stop(t+d+0.05);});
  burst(t,isLong?2400:4200,1.2,0.35*vol,0.015);
  if(isLong){ const o=c.createOscillator(); o.type='sine'; o.frequency.setValueAtTime(72*pitchMul,t); o.frequency.linearRampToValueAtTime(104*pitchMul,t+Math.min(0.45,dur));
    const g=c.createGain(); g.gain.setValueAtTime(0,t); g.gain.linearRampToValueAtTime(1.1*vol,t+0.006); g.gain.exponentialRampToValueAtTime(0.0006,t+Math.min(0.9,dur*1.4));
    o.connect(g); g.connect(A.dest||A.out); o.start(t); o.stop(t+1); }
}
/* pentatonic-ish frequency ratios, close to 1 so the result still reads as "tabla" and not
   a xylophone; settings.melodicContour (default false) gates this on. */
const PENTA=[1,9/8,5/4,3/2,27/16];
function pitchContourMul(footIdx,posInFoot,isCaesuraFoot,isLastFoot){
  if(!settings.melodicContour) return 1;
  let step = isLastFoot?0:(footIdx%PENTA.length);
  if(isCaesuraFoot) step=Math.max(0,step-1);
  return PENTA[step]*(1+Math.min(3,posInFoot)*0.01);
}
/* tanpura-ish drone: a quiet tonal center under the whole line so long/short reads as a
   pattern against a key, not hits in silence. 3 detuned oscillators (root/fifth/octave) +
   a slow amplitude wobble. settings.drone (default true for 'tabla') gates this on. */
function drone(t0,dur){
  const c=A.ctx, bus=c.createGain(); bus.gain.value=0;
  const lp=c.createBiquadFilter(); lp.type='lowpass'; lp.frequency.value=900; bus.connect(lp); lp.connect(A.dest||A.out);
  [1,1.5,2].forEach((r,i)=>{ const o=c.createOscillator(); o.type=i===0?'sawtooth':'sine';
    o.frequency.value=130.81*r*(1+(Math.random()-0.5)*0.004);
    const g=c.createGain(); g.gain.value=i===0?0.5:(i===1?0.26:0.12);
    o.connect(g); g.connect(bus); o.start(t0); o.stop(t0+dur+0.4); });
  const lfo=c.createOscillator(); lfo.frequency.value=0.18+Math.random()*0.04;
  const lfoG=c.createGain(); lfoG.gain.value=0.011; lfo.connect(lfoG); lfoG.connect(bus.gain);
  lfo.start(t0); lfo.stop(t0+dur+0.4);
  bus.gain.setValueAtTime(0,t0); bus.gain.linearRampToValueAtTime(0.045,t0+0.6);
  bus.gain.setValueAtTime(0.045,t0+dur-0.5); bus.gain.linearRampToValueAtTime(0,t0+dur+0.35);
}

