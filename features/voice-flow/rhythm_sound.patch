EDIT 1 of 4 -- tabla(): accept an optional pitch multiplier (default 1 = identical to today)
--------------------------------------------------------------------
OLD:
function tabla(t,dur,isLong,vol){
  const c=A.ctx, f=isLong?311:370, decay=isLong?Math.min(0.7,dur*1.1):Math.min(0.2,dur*0.9);
  [1,2,3,4.15].forEach((h,i)=>{const o=c.createOscillator(); o.type='sine'; o.frequency.value=f*h;
    const g=c.createGain(); const d=decay/(1+i*0.7); g.gain.setValueAtTime(0,t); g.gain.linearRampToValueAtTime(0.55*vol/(i+1),t+0.004);
    g.gain.exponentialRampToValueAtTime(0.0006,t+d); o.connect(g); g.connect(A.dest||A.out); o.start(t); o.stop(t+d+0.05);});
  burst(t,isLong?2400:4200,1.2,0.35*vol,0.015);
  if(isLong){ const o=c.createOscillator(); o.type='sine'; o.frequency.setValueAtTime(72,t); o.frequency.linearRampToValueAtTime(104,t+Math.min(0.45,dur));
    const g=c.createGain(); g.gain.setValueAtTime(0,t); g.gain.linearRampToValueAtTime(1.1*vol,t+0.006); g.gain.exponentialRampToValueAtTime(0.0006,t+Math.min(0.9,dur*1.4));
    o.connect(g); g.connect(A.dest||A.out); o.start(t); o.stop(t+1); }
