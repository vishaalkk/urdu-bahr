/* ---------- recorded voice pack ---------- */
function loadRec(){
  if(A.recP) return A.recP;
  const dec=o=>{ const bin=atob(o.b64), u=new Uint8Array(bin.length); for(let i=0;i<bin.length;i++)u[i]=bin.charCodeAt(i);
    return new Promise((res)=>{ try{ const p=A.ctx.decodeAudioData(u.buffer,b=>res({buf:b,off:o.off,dur:o.dur}),()=>res(null)); if(p&&p.then)p.catch(()=>res(null)); }catch(e){res(null);} }); };
  A.recP=Promise.all([Promise.all(VOICEPACK.da.map(dec)),Promise.all(VOICEPACK.dum.map(dec))])
    .then(([da,dum])=>{ A.rec={da:da.filter(Boolean),dum:dum.filter(Boolean),last:{l:-1,s:-1}}; });
  return A.recP;
}
/* choose the take whose sounding length best fits the slot, never the same take twice running */
function recSound(t,dur,isLong,vol,pos,holdF){
  const R=A.rec; if(!R||!R.da.length||!R.dum.length) return voice(t,dur,isLong,'dumda',vol,pos);
  const pool=isLong?R.dum:R.da, key=isLong?'l':'s';
  let bi=0,bs=1e9; pool.forEach((k,j)=>{ const sc=Math.abs((k.dur-k.off)-dur*0.95)+(j===R.last[key]?0.2:0); if(sc<bs){bs=sc;bi=j;} });
  R.last[key]=bi; const k=pool[bi];
