EDIT 4 of 6 -- mineSound(): same no-abrupt-cut fix for the user's own single-take recording
--------------------------------------------------------------------
OLD:
function mineSound(t,dur,isLong,vol){
  const buf=isLong?(mine.dum||mine.da):(mine.da||mine.dum); if(!buf) return voice(t,dur,isLong,'dumda',vol,0);
  const c=A.ctx, s=c.createBufferSource(); s.buffer=buf; const g=c.createGain();
  const hold=Math.min(buf.duration,dur*0.93);
  g.gain.setValueAtTime(vol,t); g.gain.setValueAtTime(vol,t+Math.max(0.02,hold-0.04)); g.gain.linearRampToValueAtTime(0,t+hold);
  s.connect(g); g.connect(A.dest||A.voiceBus||A.out); s.start(t); s.stop(t+hold+0.02);
}

NEW:
function mineSound(t,dur,isLong,vol,ctx){
  const buf=isLong?(mine.dum||mine.da):(mine.da||mine.dum); if(!buf) return voice(t,dur,isLong,'dumda',vol,0);
  ctx=ctx||{};
  const c=A.ctx, s=c.createBufferSource(); s.buffer=buf; const g=c.createGain();
  const xfade=ctx.xfade!=null?ctx.xfade:0.02;
  let fadeStart=(ctx.nextOnset!=null?ctx.nextOnset-xfade/2:t+dur); fadeStart=Math.max(fadeStart,t+0.02);
  const fadeEnd=fadeStart+(ctx.nextOnset!=null?xfade:xfade*1.5);
  const hold=Math.min(buf.duration,fadeStart-t);
  g.gain.setValueAtTime(vol,t); g.gain.setValueAtTime(vol,t+hold);
  g.gain.setValueCurveAtTime(eqPowerFade(vol,10),t+hold,Math.max(0.01,fadeEnd-(t+hold)));
  s.connect(g); g.connect(A.dest||A.voiceBus||A.out); s.start(t); s.stop(t+Math.max(hold,fadeEnd-t)+0.02);
}

