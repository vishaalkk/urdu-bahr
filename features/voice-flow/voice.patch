function syllableSound(t,dur,isLong,vol,pos,ctx){
  ctx=ctx||{};
  const s=settings.sound;
  if(s==='tabla') tabla(t,dur,isLong,vol); else if(s==='tone') tone(t,dur,isLong,vol);
  else if(s==='mine') mineSound(t,dur,isLong,vol,ctx); else if(s==='rec') recSound(t,dur,isLong,vol,pos,ctx); else voice(t,dur,isLong,s,vol,pos,ctx.pitchLift?1.015:1);
}

--------------------------------------------------------------------
EDIT 6 of 6 -- play(): two-pass scheduling -- legato within a foot, a deliberate breath between feet
--------------------------------------------------------------------
OLD:
/* seq of 'l','s','x','c'; onStep(i) fires as each syllable sounds */
function play(seq,opts){
  opts=opts||{}; if(!A.ensure())return 0;
  if(settings.sound==='rec' && !A.rec){ loadRec().then(()=>play(seq,opts)); return (seq.length*1.5*60/settings.bpm); }
  stopAll();
  const sess=A.ctx.createGain(); sess.gain.value=1; sess.connect(A.voiceBus||A.out); A.sess=sess; A.dest=sess;
  const beat=60/(opts.bpm||settings.bpm); let t=A.ctx.currentTime+0.16; const t0=t;
  const F=opts.feet, cae=opts.cae||[];
  seq.forEach((v,i)=>{
    const isLong=(v==='l'||v==='x'); let dur=(isLong?2:1)*beat;
    let vol=v==='c'?0.45:1, hold=0.97;
    if(F){ const fs=(i===0||F[i]!==F[i-1]), fe=(i===seq.length-1||F[i+1]!==F[i]);
      if(fs && i>0 && cae.includes(F[i])) t+=beat*0.6;              /* breath at the mid-line break */
      if(fs && settings.footPulse!==false && v!=='c') footThump(t,0.9);
      if(!fs && v!=='c') vol*=0.84;                                   /* stress the foot's first syllable */
      if(fe && i<seq.length-1){ dur*=1.07; hold=0.82; }               /* a little lift at the end of each foot */
    }
    if(opts.cadence!==false && i===seq.length-1 && seq.length>4) dur*=1.4;
    syllableSound(t,dur,isLong,vol,i/Math.max(1,seq.length-1),hold);
    if(opts.onStep) A.timers.push(setTimeout(()=>opts.onStep(i),(t-A.ctx.currentTime)*1000));
    t+=dur;
  });
  if(opts.onEnd) A.timers.push(setTimeout(opts.onEnd,(t-A.ctx.currentTime)*1000+60));
  return (t-t0);
}

NEW:
/* seq of 'l','s','x','c'; onStep(i) fires as each syllable sounds.
   Syllables that share a foot (opts.feet) are glued together with a short crossfade so the
   foot reads as one recited unit; a small breath sits between feet, a longer one at a
   caesura (opts.cae) or the mid-line break. Without opts.feet this still removes the old
   gaps/clicks, it just has nothing to phrase into feet. */
function play(seq,opts){
  opts=opts||{}; if(!A.ensure())return 0;
  if(settings.sound==='rec' && !A.rec){ loadRec().then(()=>play(seq,opts)); return (seq.length*1.5*60/settings.bpm); }
  stopAll();
  const sess=A.ctx.createGain(); sess.gain.value=1; sess.connect(A.voiceBus||A.out); A.sess=sess; A.dest=sess;
  const beat=60/(opts.bpm||settings.bpm); const t0=A.ctx.currentTime+0.16;
  const F=opts.feet||null, cae=opts.cae||[], n=seq.length;
  const footGapUnits=opts.footGap!=null?opts.footGap:0.16, caeGapUnits=opts.caeGap!=null?opts.caeGap:0.6;
  const xfade=opts.xfade!=null?opts.xfade:0.02;
  /* pass 1: lay out onsets, slot lengths, and the deliberate breaths between feet / at the caesura */
  const slots=[]; let t=t0;
  seq.forEach((v,i)=>{
    const isLong=(v==='l'||v==='x'); let dur=(isLong?2:1)*beat;
    let vol=v==='c'?0.45:1, pitchLift=false;
    const fs=F?(i===0||F[i]!==F[i-1]):(i===0), fe=F?(i===n-1||F[i+1]!==F[i]):(i===n-1);
    if(F && fs && i>0 && cae.includes(F[i])) t+=beat*caeGapUnits;      /* breath at the mid-line break */
    if(fs && v!=='c'){ vol*=1.12; if(isLong) pitchLift=true; }          /* stress the foot's ictus, a touch brighter */
    else if(v!=='c') vol*=0.92;                                        /* gentle decay across the rest of the foot */
    if(opts.cadence!==false && i===n-1 && n>4) dur*=1.4;               /* a little rest at the very end of the line */
    const gapAfter=(F && fe && i<n-1) ? beat*footGapUnits : 0;
    slots.push({i,v,isLong,dur,vol,pitchLift,fs,foot:F?F[i]:0,onset:t});
    t+=dur+gapAfter;
  });
  /* pass 2: schedule audio, gluing same-foot syllables together (legato) and keeping the take
     choice consistent within a foot so a run like dum-dum-dum doesn't jitter between voices */
  const footTake={};
  slots.forEach((sl,i)=>{
    const next=slots[i+1];
    if(F && settings.footPulse!==false && sl.fs && sl.v!=='c') footThump(sl.onset,0.9);
    const ctx={footKey:F?(sl.foot+':'+(sl.isLong?'l':'s')):null, footTake, pitchLift:sl.pitchLift,
               nextOnset:next?next.onset:null, xfade};
    syllableSound(sl.onset,sl.dur,sl.isLong,sl.vol,i/Math.max(1,n-1),ctx);
    if(opts.onStep) A.timers.push(setTimeout(()=>opts.onStep(i),(sl.onset-A.ctx.currentTime)*1000));
  });
  const last=slots[n-1], endT=last.onset+last.dur;
  if(opts.onEnd) A.timers.push(setTimeout(opts.onEnd,(endT-A.ctx.currentTime)*1000+60));
  return (endT-t0);
}

